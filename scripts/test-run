#!/usr/bin/env python3
"""Run a command and keep one log of the run in one format.

    test-run <spec id> <name> -- <command...>
    test-run <spec id> <name> --container <set> -- <cargo args>
    test-run show <spec id>

The log is <base checkout>/.superpowers/pod/test-logs/<spec id>/<UTC time>-<name>.log.
"""
from datetime import datetime, timezone
import glob
import importlib.util
import os
from pathlib import Path
import re
import shlex
import signal
import subprocess
import sys
import time

KEBAB = re.compile(r'^[a-z0-9]+(-[a-z0-9]+)*$')
RESULT_LINE = re.compile(rb'test result:.*?(\d+) passed; (\d+) failed; (\d+) ignored')
OK_LINE = re.compile(rb'^test (.+) \.\.\. ok$')
CONTAINER_SETS = Path(__file__).resolve().parent / 'container-tests'
IMAGE = 'harold-tests'
NETWORK = 'harold-tests'
TEST_IDS = 'uid=1000,gid=1000'
FETCH = ['cargo', 'fetch', '--locked', '--target', 'aarch64-unknown-linux-gnu']
CARGO_TEST = ['cargo', 'test', '--locked', '--offline', '-p', 'harold', '--no-default-features',
              '--features', 'harold/linux-defaults', '--', '--ignored', '--exact']
ENV_VALUES = {
    'HOME': '/home/test',
    'XDG_CONFIG_HOME': '/home/test/.config',
    'XDG_DATA_HOME': '/home/test/.local/share',
    'XDG_STATE_HOME': '/home/test/.local/state',
    'XDG_CACHE_HOME': '/home/test/.cache',
    'CARGO_HOME': '/cargo',
    'CARGO_TARGET_DIR': '/target',
    'PATH': '/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin',
}
# Runs in the container. It copies the index cache and the crate files from the read-only
# seed, then runs cargo. The test names come in as "$@".
CONTAINER_SCRIPT = """set -e
mkdir -p /cargo/registry/index /cargo/registry/cache /cargo/git/db
if [ -d /cargo-seed/index ]; then cp -rn /cargo-seed/index/. /cargo/registry/index/; fi
if [ -d /cargo-seed/cache ]; then cp -rn /cargo-seed/cache/. /cargo/registry/cache/; fi
if [ -d /cargo-seed/git-db ]; then cp -rn /cargo-seed/git-db/. /cargo/git/db/; fi
cd /src
exec """ + ' '.join(CARGO_TEST) + """ "$@"
"""
LOG_DIR = Path('.superpowers') / 'pod' / 'test-logs'


def base_checkout(cwd):
    """Return the worktree whose branch is refs/heads/main, or None."""
    try:
        out = subprocess.run(['git', 'worktree', 'list', '--porcelain'], cwd=cwd,
                             capture_output=True, text=True).stdout
    except OSError:
        return None
    for block in out.split('\n\n'):
        path = None
        branch = None
        for line in block.splitlines():
            if line.startswith('worktree '):
                path = line[len('worktree '):]
            elif line.startswith('branch '):
                branch = line[len('branch '):]
        if path and branch == 'refs/heads/main':
            return Path(path)
    return None


def stamp(now):
    return now.strftime('%Y%m%dT%H%M%SZ')


def log_path(base, spec_id, name, now):
    """Return a log path that does not exist yet: add -2, -3 to the name."""
    folder = Path(base) / LOG_DIR / spec_id
    path = folder / f'{stamp(now)}-{name}.log'
    count = 1
    while path.exists():
        count += 1
        path = folder / f'{stamp(now)}-{name}-{count}.log'
    return path


def sum_results(text):
    """Sum the `test result:` lines. Return None when there are none."""
    data = text if isinstance(text, bytes) else text.encode()
    totals = [0, 0, 0]
    found = False
    for line in data.splitlines():
        match = RESULT_LINE.search(line)
        if match:
            found = True
            for i in range(3):
                totals[i] += int(match.group(i + 1))
    if not found:
        return None
    return f'{totals[0]} passed, {totals[1]} failed, {totals[2]} ignored'


def commit_of(cwd):
    def git(where, *args):
        return subprocess.run(['git', *args], cwd=where, capture_output=True, text=True).stdout
    commit = git(cwd, 'rev-parse', '--short', 'HEAD').strip()
    if not commit:
        return 'none'
    # Check the whole tree, also when the cwd is a subfolder.
    top = git(cwd, 'rev-parse', '--show-toplevel').strip() or cwd
    # The kept logs are not a change of the tree.
    if git(top, 'status', '--porcelain', '--', '.', ':(top,exclude).superpowers').strip():
        commit += ' dirty'
    return commit


def rfc3339(moment):
    return moment.strftime('%Y-%m-%dT%H:%M:%SZ')


def open_log(base, spec_id, name, now):
    while True:
        path = log_path(base, spec_id, name, now)
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        except FileExistsError:
            continue
        return path, os.fdopen(fd, 'wb')


def run(spec_id, name, command, cwd=None, container=None):
    """Run the command, keep the log and return the exit code.

    With `container` (a dict from `run_container`), `command` is only the text shown in the
    header. The runner fetches the crates, then runs the container command.
    """
    cwd = Path(cwd).resolve() if cwd else Path.cwd()
    for label, value in (('id', spec_id), ('name', name)):
        if not KEBAB.match(value):
            print(f'test-run: bad {label} {value!r}: use kebab-case', file=sys.stderr)
            return 2
    if not command:
        print('test-run: no command', file=sys.stderr)
        return 2
    base = base_checkout(cwd)
    if base is None:
        print('test-run: no worktree of main found: nothing written', file=sys.stderr)
        return 2
    commit = commit_of(cwd)
    started = datetime.now(timezone.utc)
    path, log = open_log(base, spec_id, name, started)
    env = dict(os.environ, TEST_RUN_DIR=str(path.parent), TEST_RUN_STEM=path.stem)
    header = [('test-run', '1'), ('id', spec_id), ('name', name),
              ('command', shlex.join(command).replace('\r', '\\r').replace('\n', '\\n')), ('cwd', str(cwd)),
              ('commit', commit), ('started', rfc3339(started))]
    if container:
        header.insert(6, ('container', container['label']))
        header.append(('dpkg', container['dpkg']))
    with log:
        log.write(''.join(f'# {k}: {v}\n' for k, v in header).encode())
        log.flush()
        t0 = time.monotonic()
        if container:
            before = cached_crates()
            code, stopped, tail, matched = execute(FETCH, cwd, env, log)
            if tail not in (b'', b'\n'):
                log.write(b'\n')
            fetched = sorted(cached_crates() - before)
            log.write(f'# fetched: {" ".join(fetched) or "none"}\n'.encode())
            if code == 0 and not stopped:
                out_dir = path.parent / f'{path.stem}.out'
                out_dir.mkdir()
                ok_lines = []
                code, stopped, tail, matched = execute(
                    container['build'](out_dir), cwd, env, log, ok_lines)
                code = finish_container(code, out_dir, path, container['names'], ok_lines, log)
        else:
            code, stopped, tail, matched = execute(command, cwd, env, log)
        if tail not in (b'', b'\n'):
            log.write(b'\n')
        duration = time.monotonic() - t0
        result = 'stopped' if stopped else ('passed' if code == 0 else 'failed')
        sums = sum_results(b'\n'.join(matched))
        if sums:
            result += ', ' + sums
        footer = [('finished', rfc3339(datetime.now(timezone.utc))),
                  ('duration_s', f'{duration:.1f}'), ('exit', str(code)), ('result', result)]
        log.write(''.join(f'# {k}: {v}\n' for k, v in footer).encode())
    return code


def execute(command, cwd, env, log, ok_lines=None):
    """Run the command, copy its output. Return (exit code, stopped, last byte, result lines).

    When `ok_lines` is a list, it gets each `test <name> ... ok` line.
    """
    try:
        proc = subprocess.Popen(command, cwd=cwd, env=env, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT)
    except OSError as err:
        msg = f'test-run: cannot run {command[0]}: {err.strerror or err}\n'.encode()
        log.write(msg)
        sys.stdout.buffer.write(msg)
        sys.stdout.buffer.flush()
        return (127 if isinstance(err, FileNotFoundError) else 126), False, b'\n', []
    forwarded = []

    def forward(signum, _frame):
        # On a terminal, Ctrl-C reaches the child by the process group already.
        # So SIGINT is only noted here. SIGTERM is sent on.
        forwarded.append(signum)
        if signum == signal.SIGINT:
            return
        try:
            proc.send_signal(signum)
        except ProcessLookupError:
            pass

    old = {}
    try:
        for signum in (signal.SIGINT, signal.SIGTERM):
            old[signum] = signal.signal(signum, forward)
    except ValueError:  # not the main thread
        pass
    last = b''
    pending = b''
    matched = []
    try:
        while True:
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                break
            log.write(chunk)
            log.flush()
            sys.stdout.buffer.write(chunk)
            sys.stdout.buffer.flush()
            last = chunk[-1:]
            lines = (pending + chunk).split(b'\n')
            pending = lines.pop()
            matched += [l for l in lines if RESULT_LINE.search(l)]
            if ok_lines is not None:
                ok_lines += [l for l in lines if OK_LINE.match(l)]
        proc.wait()
        proc.stdout.close()
        if RESULT_LINE.search(pending):
            matched.append(pending)
        if ok_lines is not None and OK_LINE.match(pending):
            ok_lines.append(pending)
    finally:
        for signum, handler in old.items():
            signal.signal(signum, handler)
    if proc.returncode < 0:
        return 128 - proc.returncode, True, last, matched
    return proc.returncode, bool(forwarded), last, matched


def load_set(name, root):
    """Return the test names of the container test set `name`, in order, with no duplicates."""
    def refuse(message):
        print(f'test-run: {message}', file=sys.stderr)
        raise SystemExit(2)
    if not KEBAB.match(name):
        refuse(f'bad container test set {name!r}: use kebab-case')
    path = Path(root) / f'{name}.txt'
    if not path.is_file():
        refuse(f'no container test set {name!r}')
    names = []
    for line in path.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith('#') and line not in names:
            names.append(line)
    if not names:
        refuse(f'container test set {name!r} has no test names')
    return names


def podman_command(worktree, out, seed, image, names):
    """Return the `podman run` command line. `seed` holds the Mac's cargo files to mount."""
    command = ['podman', 'run', '--rm', '--network', NETWORK, '--no-hosts', '--cap-drop', 'all',
               '--security-opt', 'no-new-privileges', '--read-only', '--user', 'test']
    mounts = [f'{worktree}:/src:ro']
    for index in seed.get('index', []):
        mounts.append(f'{index}:/cargo-seed/index/{Path(index).name}:ro')
    if seed.get('cache'):
        mounts.append(f'{seed["cache"]}:/cargo-seed/cache:ro')
    if seed.get('git'):
        mounts.append(f'{seed["git"]}:/cargo-seed/git-db:ro')
    mounts += ['harold-test-cargo:/cargo', 'harold-test-target:/target', f'{out}:/out']
    for mount in mounts:
        command += ['-v', mount]
    for target in ('/tmp', '/home/test'):
        command += ['--tmpfs', f'{target}:mode=0700,{TEST_IDS}']
    for key, value in ENV_VALUES.items():
        command += ['-e', f'{key}={value}']
    return command + [image, 'sh', '-c', CONTAINER_SCRIPT, 'sh'] + list(names)


def count_ok(output, names):
    """Return the names with no `test <name> ... ok` line in the output, in order."""
    seen = set()
    for line in output.splitlines():
        match = OK_LINE.match(line.rstrip(b'\r'))
        if match:
            seen.add(match.group(1).decode('utf-8', 'replace'))
    return [name for name in names if name not in seen]


def first_secret(text):
    """Use the secret patterns of call_test.py, loaded by file path."""
    path = Path(__file__).resolve().parent / 'call_test.py'
    spec = importlib.util.spec_from_file_location('call_test_patterns', path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.first_secret(text)


def collect_out(out, folder, stem):
    """Move each result file of `out` to `<folder>/<stem>-<part>`. Return the new paths.

    A file with a secret is not kept. A `.withheld` note names the pattern instead.
    """
    moved = []
    for path in sorted(Path(out).iterdir()):
        if path.is_symlink() or not path.is_file():
            continue
        found = first_secret(path.read_text(errors='replace'))
        if found is None:
            target = Path(folder) / f'{stem}-{path.name}'
            path.replace(target)
        else:
            target = Path(folder) / f'{stem}-{path.name}.withheld'
            target.write_text(found + '\n')
            path.unlink()
        moved.append(target)
    try:
        Path(out).rmdir()
    except OSError:
        pass
    return moved


def finish_container(code, out_dir, path, names, ok_lines, log):
    """Move the result files, check that every test ran and return the exit code."""
    collect_out(out_dir, path.parent, path.stem)
    missing = count_ok(b'\n'.join(ok_lines), names)
    if missing:
        msg = ('test-run: these tests did not run: ' + ', '.join(missing) + '\n').encode()
        log.write(msg)
        sys.stdout.buffer.write(msg)
        sys.stdout.buffer.flush()
        return code or 1
    return code


def cargo_home():
    return Path(os.environ.get('CARGO_HOME') or Path.home() / '.cargo')


def cached_crates():
    """Return the names (`<crate>-<version>`) of the crate files in the Mac's registry cache."""
    return {p.name[:-len('.crate')]
            for p in (cargo_home() / 'registry' / 'cache').glob('*/*.crate')}


def podman_out(*args):
    """Run podman. Return (exit code, output), or (127, '') when podman is missing."""
    try:
        done = subprocess.run(['podman', *args], capture_output=True, text=True)
    except OSError:
        return 127, ''
    return done.returncode, done.stdout.strip()


def run_container(spec_id, name, set_name, cargo_args, cwd=None):
    """Run the container test set in a podman container. The cargo command is fixed.

    `cargo_args` (the words after `--`) are not used: the set decides what runs.
    """
    cwd = Path(cwd).resolve() if cwd else Path.cwd()
    names = load_set(set_name, CONTAINER_SETS)
    code, state = podman_out('machine', 'inspect', '--format', '{{.State}}')
    if code != 0 or state != 'running':
        print('test-run: podman machine is not running: podman machine start', file=sys.stderr)
        return 1
    if podman_out('network', 'exists', NETWORK)[0] != 0:
        if podman_out('network', 'create', '--internal', NETWORK)[0] != 0:
            print(f'test-run: cannot make the podman network {NETWORK}', file=sys.stderr)
            return 1
    code, image_id = podman_out('image', 'inspect', '--format', '{{.Id}}', IMAGE)
    if code != 0 or not image_id:
        print(f'test-run: no image {IMAGE}: podman build -t {IMAGE} scripts/container-tests',
              file=sys.stderr)
        return 1
    digest = podman_out('image', 'inspect', '--format',
                        '{{index .Annotations "org.opencontainers.image.base.digest"}}',
                        IMAGE)[1] or 'unknown'
    # The packages are read before the log opens: the image does not change during a run.
    code, packages = podman_out('run', '--rm', '--network', 'none', '--cap-drop', 'all',
                                '--read-only', '--user', 'test', '--entrypoint', 'dpkg-query',
                                IMAGE, '-W', '-f', '${Package}=${Version}\\n')
    dpkg = ' '.join(packages.split()) if code == 0 and packages else 'unknown'
    top = subprocess.run(['git', 'rev-parse', '--show-toplevel'], cwd=cwd, capture_output=True,
                         text=True).stdout.strip() or str(cwd)
    cargo = cargo_home()
    seed = {'index': [Path(p) for p in sorted(glob.glob(
                str(cargo / 'registry' / 'index' / 'index.crates.io-*')))],
            'cache': cargo / 'registry' / 'cache', 'git': cargo / 'git' / 'db'}
    seed = {k: v for k, v in seed.items() if v and (v if k == 'index' else v.is_dir())}
    container = {
        'label': f'{image_id} from {digest}', 'dpkg': dpkg, 'names': names,
        'build': lambda out: podman_command(top, out, seed, IMAGE, names)}
    return run(spec_id, name, CARGO_TEST + names, cwd, container)


def read_ends(path):
    """Return (first 20 lines, lines of the last 4 KB) without a read of the whole file."""
    size = os.path.getsize(path)
    with open(path, 'rb') as handle:
        head = [handle.readline().decode('utf-8', 'replace').rstrip('\n') for _ in range(20)]
        head = [line for line in head]
        start = max(0, size - 4096)
        handle.seek(start)
        data = handle.read()
    lines = data.decode('utf-8', 'replace').split('\n')
    if start > 0:
        lines = lines[1:]  # the first line may be cut
    return head, [line for line in lines if line]


def read_log(path):
    """Return (header, footer) dicts, or None when it is not a test-run log.

    A part file (-harold.log and so on) has no `# test-run: 1` first line,
    so this check skips it, as it skips a headerless tee log.
    """
    head, tail = read_ends(path)
    if not head or head[0] != '# test-run: 1':
        return None
    header = {}
    for line in head[1:]:
        match = re.match(r'# (\w+): (.*)$', line)
        if not match:
            break
        header[match.group(1)] = match.group(2)
    footer = {}
    for line in tail:
        match = re.match(r'# (finished|duration_s|exit|result): (.*)$', line)
        if match:
            footer[match.group(1)] = match.group(2)
    return header, footer


def show(spec_id, base):
    rows = []
    folder = Path(base) / LOG_DIR / spec_id
    if not folder.is_dir():
        return rows
    for path in sorted(folder.glob('*.log')):
        parsed = read_log(path)
        if parsed is None:
            continue
        header, footer = parsed
        done = 'finished' in footer and 'exit' in footer
        rows.append({
            'time': path.name.split('-', 1)[0],
            'name': header.get('name', ''),
            'commit': header.get('commit', ''),
            'seconds': footer.get('duration_s', '') if done else '',
            'result': footer.get('result', 'unfinished') if done else 'unfinished',
            'features': 'timing' if 'timing-tests' in header.get('command', '') else '',
        })
    return rows


def main(argv):
    if len(argv) == 2 and argv[0] == 'show':
        base = base_checkout(Path.cwd())
        if base is None:
            print('test-run: no worktree of main found', file=sys.stderr)
            return 2
        rows = show(argv[1], base)
        if not rows:
            print(f'test-run: no kept runs for spec id {argv[1]!r}', file=sys.stderr)
        for row in rows:
            print('  '.join(str(row[k]) for k in
                            ('time', 'name', 'commit', 'seconds', 'result', 'features')).rstrip())
        return 0
    if len(argv) >= 5 and argv[2] == '--container' and argv[4] == '--':
        return run_container(argv[0], argv[1], argv[3], argv[5:], Path.cwd())
    if len(argv) >= 4 and argv[2] == '--':
        return run(argv[0], argv[1], argv[3:])
    print('usage: test-run <spec id> <name> -- <command...>\n       test-run <spec id> <name> --container <set> -- <cargo args>\n       test-run show <spec id>',
          file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
