{
  "name": "Harold trends",
  "tags": [
    "harold"
  ],
  "tiles": [
    {
      "id": "slots",
      "name": "Slots",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 6,
      "config": {
        "configType": "sql",
        "displayType": "line",
        "connectionId": "@CLICKHOUSE_CONNECTION_ID@",
        "sourceId": "@METRICS_SOURCE_ID@",
        "sqlTemplate": "SELECT $__timeInterval(TimeUnix) AS ts, Attributes['pod.product'] AS product, avgIf(Value, MetricName = 'pod.slots.busy') AS busy, quantileIf(0.95)(Value, MetricName = 'pod.slots.busy') AS busy_p95, avgIf(Value >= 1, MetricName = 'pod.slots.free') AS share_of_time_a_slot_is_free FROM $__sourceTable(gauge) WHERE MetricName IN ('pod.slots.busy', 'pod.slots.free') AND $__timeFilter(TimeUnix) AND $__filters GROUP BY ts, product ORDER BY ts"
      }
    },
    {
      "id": "merges-to-main",
      "name": "Merges to main",
      "x": 12,
      "y": 0,
      "w": 12,
      "h": 6,
      "config": {
        "configType": "sql",
        "displayType": "line",
        "connectionId": "@CLICKHOUSE_CONNECTION_ID@",
        "sourceId": "@METRICS_SOURCE_ID@",
        "sqlTemplate": "SELECT $__timeInterval(TimeUnix) AS ts, sumIf(rise, MetricName = 'pod.merges') AS merges, sumIf(rise, MetricName = 'pod.merged_lines') AS lines_merged, if(merges = 0, NULL, lines_merged / merges) AS lines_per_merge FROM (SELECT TimeUnix, MetricName, Attributes, if(Value >= before, Value - before, Value) AS rise FROM (SELECT TimeUnix, MetricName, Attributes, Value, lagInFrame(Value, 1, toFloat64(0)) OVER (PARTITION BY cityHash64(MetricName, ResourceAttributes, Attributes) ORDER BY TimeUnix ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS before FROM $__sourceTable(sum) WHERE MetricName IN ('pod.merges', 'pod.merged_lines') AND TimeUnix >= $__fromTime - INTERVAL 1 DAY AND TimeUnix <= $__toTime AND $__filters)) WHERE $__timeFilter(TimeUnix) GROUP BY ts ORDER BY ts"
      }
    },
    {
      "id": "phone-requests-right-agent",
      "name": "Phone requests reaching the right agent",
      "x": 0,
      "y": 6,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "line",
        "sourceId": "@METRICS_SOURCE_ID@",
        "select": [
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "harold.phone_requests",
            "metricType": "sum",
            "where": "Attributes['outcome'] = 'typed'",
            "whereLanguage": "sql",
            "alias": "typed"
          },
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "harold.phone_requests",
            "metricType": "sum",
            "where": "Attributes['outcome'] = 'unavailable'",
            "whereLanguage": "sql",
            "alias": "unavailable"
          },
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "harold.phone_requests.wrong",
            "metricType": "sum",
            "where": "",
            "whereLanguage": "sql",
            "alias": "wrong"
          }
        ],
        "formulas": [
          {
            "expression": "A / (A + B)",
            "alias": "availability",
            "numberFormat": {
              "output": "percent",
              "mantissa": 1
            }
          },
          {
            "expression": "(A - C) / (A + B)",
            "alias": "right agent",
            "numberFormat": {
              "output": "percent",
              "mantissa": 1
            }
          }
        ],
        "showOperandSeries": true
      }
    },
    {
      "id": "phone-request-latency",
      "name": "Phone request latency",
      "x": 12,
      "y": 6,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "line",
        "sourceId": "@TRACES_SOURCE_ID@",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.5,
            "valueExpression": "Duration / 1e9",
            "alias": "median",
            "where": "ServiceName = 'harold' AND SpanName = 'harold.phone_request' AND SpanAttributes['pane_id'] != ''",
            "whereLanguage": "sql"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Duration / 1e9",
            "alias": "p95",
            "where": "ServiceName = 'harold' AND SpanName = 'harold.phone_request' AND SpanAttributes['pane_id'] != ''",
            "whereLanguage": "sql"
          }
        ],
        "numberFormat": {
          "output": "time",
          "factor": 1
        }
      }
    },
    {
      "id": "one-turn",
      "name": "One turn, end to end",
      "x": 0,
      "y": 12,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "search",
        "sourceId": "@TRACES_SOURCE_ID@",
        "whereLanguage": "sql",
        "where": "ServiceName = 'harold' AND SpanName = 'harold.turn'",
        "select": "Timestamp, SpanAttributes['session.id'], SpanAttributes['pane_id'], SpanAttributes['started_by'], Duration / 1e9 AS seconds, TraceId"
      }
    },
    {
      "id": "turns-per-session",
      "name": "Turns per session",
      "x": 12,
      "y": 12,
      "w": 12,
      "h": 6,
      "config": {
        "configType": "sql",
        "displayType": "stacked_bar",
        "connectionId": "@CLICKHOUSE_CONNECTION_ID@",
        "sourceId": "@METRICS_SOURCE_ID@",
        "sqlTemplate": "SELECT $__timeInterval(TimeUnix) AS ts, Attributes['session.id'] AS session, sum(rise) AS turns FROM (SELECT TimeUnix, MetricName, Attributes, if(Value >= before, Value - before, Value) AS rise FROM (SELECT TimeUnix, MetricName, Attributes, Value, lagInFrame(Value, 1, toFloat64(0)) OVER (PARTITION BY cityHash64(MetricName, ResourceAttributes, Attributes) ORDER BY TimeUnix ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS before FROM $__sourceTable(sum) WHERE MetricName IN ('harold.turns') AND TimeUnix >= $__fromTime - INTERVAL 1 DAY AND TimeUnix <= $__toTime)) WHERE $__timeFilter(TimeUnix) GROUP BY ts, session ORDER BY ts"
      }
    },
    {
      "id": "specs-by-state",
      "name": "Specs by state",
      "x": 0,
      "y": 18,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "line",
        "sourceId": "@METRICS_SOURCE_ID@",
        "select": [
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "pod.specs",
            "metricType": "gauge",
            "where": "",
            "whereLanguage": "sql",
            "alias": "specs"
          }
        ],
        "groupBy": "Attributes['pod.product'], Attributes['state']"
      }
    },
    {
      "id": "spec-size",
      "name": "Spec size",
      "x": 12,
      "y": 18,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "table",
        "sourceId": "@METRICS_SOURCE_ID@",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "Value",
            "metricName": "pod.spec.words",
            "metricType": "gauge",
            "where": "",
            "whereLanguage": "sql",
            "alias": "words"
          }
        ],
        "groupBy": "Attributes['pod.product'], Attributes['spec.id'], Attributes['state']"
      }
    },
    {
      "id": "start-to-completion",
      "name": "Start to completion",
      "x": 0,
      "y": 24,
      "w": 12,
      "h": 6,
      "config": {
        "configType": "sql",
        "displayType": "table",
        "connectionId": "@CLICKHOUSE_CONNECTION_ID@",
        "sourceId": "@METRICS_SOURCE_ID@",
        "sqlTemplate": "SELECT Attributes['pod.product'] AS product, Attributes['phase'] AS phase, quantileExactWeighted(0.5)(total_rise / count_rise, toUInt64(count_rise)) AS p50, quantileExactWeighted(0.95)(total_rise / count_rise, toUInt64(count_rise)) AS p95 FROM (SELECT TimeUnix, Attributes, if(count < count_before, count, count - count_before) AS count_rise, if(count < count_before, total, total - total_before) AS total_rise FROM (SELECT TimeUnix, Attributes, toFloat64(Count) AS count, Sum AS total, lagInFrame(toFloat64(Count), 1, toFloat64(0)) OVER (PARTITION BY cityHash64(MetricName, ResourceAttributes, Attributes) ORDER BY TimeUnix ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS count_before, lagInFrame(Sum, 1, toFloat64(0)) OVER (PARTITION BY cityHash64(MetricName, ResourceAttributes, Attributes) ORDER BY TimeUnix ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS total_before FROM $__sourceTable(histogram) WHERE MetricName = 'pod.spec.lead_time' AND TimeUnix >= $__fromTime - INTERVAL 1 DAY AND TimeUnix <= $__toTime AND $__filters)) WHERE $__timeFilter(TimeUnix) AND count_rise > 0 GROUP BY product, phase ORDER BY product, phase"
      }
    },
    {
      "id": "turn-end-update-model-time",
      "name": "Turn-end update, model time",
      "x": 0,
      "y": 30,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "line",
        "sourceId": "@TRACES_SOURCE_ID@",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.5,
            "valueExpression": "Duration / 1e9",
            "alias": "median",
            "where": "ServiceName = 'harold' AND SpanName = 'harold.local_model' AND SpanAttributes['result'] = 'answered'",
            "whereLanguage": "sql"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Duration / 1e9",
            "alias": "p95",
            "where": "ServiceName = 'harold' AND SpanName = 'harold.local_model' AND SpanAttributes['result'] = 'answered'",
            "whereLanguage": "sql"
          }
        ],
        "numberFormat": {
          "output": "time",
          "factor": 1
        }
      }
    },
    {
      "id": "turn-end-updates-by-reason",
      "name": "Turn-end updates by reason",
      "x": 12,
      "y": 30,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "line",
        "sourceId": "@METRICS_SOURCE_ID@",
        "select": [
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "harold.turn_end_updates",
            "metricType": "sum",
            "where": "Attributes['outcome'] = 'model'",
            "whereLanguage": "sql",
            "alias": "model"
          },
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "harold.turn_end_updates",
            "metricType": "sum",
            "where": "Attributes['reason'] = 'too_long'",
            "whereLanguage": "sql",
            "alias": "too_long"
          },
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "harold.turn_end_updates",
            "metricType": "sum",
            "where": "Attributes['reason'] = 'no_name'",
            "whereLanguage": "sql",
            "alias": "no_name"
          },
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "harold.turn_end_updates",
            "metricType": "sum",
            "where": "Attributes['reason'] = 'model_failed'",
            "whereLanguage": "sql",
            "alias": "model_failed"
          },
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "harold.turn_end_updates",
            "metricType": "sum",
            "where": "Attributes['reason'] = 'no_model'",
            "whereLanguage": "sql",
            "alias": "no_model"
          }
        ]
      }
    }
  ]
}
