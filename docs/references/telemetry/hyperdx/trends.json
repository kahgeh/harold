{
  "name": "Harold trends",
  "tags": [
    "harold"
  ],
  "tiles": [
    {
      "id": "slots",
      "name": "Slots",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 6,
      "config": {
        "configType": "sql",
        "displayType": "line",
        "connectionId": "@CLICKHOUSE_CONNECTION_ID@",
        "sourceId": "@METRICS_SOURCE_ID@",
        "sqlTemplate": "SELECT $__timeInterval(TimeUnix) AS ts, Attributes['pod.product'] AS product, avgIf(Value, MetricName = 'pod.slots.busy') AS busy, quantileIf(0.95)(Value, MetricName = 'pod.slots.busy') AS busy_p95, avgIf(Value >= 1, MetricName = 'pod.slots.free') AS share_of_time_a_slot_is_free FROM $__sourceTable(gauge) WHERE MetricName IN ('pod.slots.busy', 'pod.slots.free') AND $__timeFilter(TimeUnix) AND $__filters GROUP BY ts, product ORDER BY ts"
      }
    },
    {
      "id": "merges-to-main",
      "name": "Merges to main",
      "x": 12,
      "y": 0,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "line",
        "sourceId": "@METRICS_SOURCE_ID@",
        "select": [
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "pod.merges",
            "metricType": "sum",
            "where": "",
            "whereLanguage": "sql",
            "alias": "merges"
          },
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "pod.merged_lines",
            "metricType": "sum",
            "where": "",
            "whereLanguage": "sql",
            "alias": "lines merged"
          }
        ],
        "formulas": [
          {
            "expression": "B / A",
            "alias": "lines per merge"
          }
        ],
        "showOperandSeries": true
      }
    },
    {
      "id": "phone-requests-right-agent",
      "name": "Phone requests reaching the right agent",
      "x": 0,
      "y": 6,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "line",
        "sourceId": "@METRICS_SOURCE_ID@",
        "select": [
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "harold.phone_requests",
            "metricType": "sum",
            "where": "Attributes['outcome'] = 'typed'",
            "whereLanguage": "sql",
            "alias": "typed"
          },
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "harold.phone_requests",
            "metricType": "sum",
            "where": "Attributes['outcome'] = 'unavailable'",
            "whereLanguage": "sql",
            "alias": "unavailable"
          },
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "harold.phone_requests.wrong",
            "metricType": "sum",
            "where": "",
            "whereLanguage": "sql",
            "alias": "wrong"
          }
        ],
        "formulas": [
          {
            "expression": "A / (A + B)",
            "alias": "availability",
            "numberFormat": {
              "output": "percent",
              "mantissa": 1
            }
          },
          {
            "expression": "(A - C) / (A + B)",
            "alias": "right agent",
            "numberFormat": {
              "output": "percent",
              "mantissa": 1
            }
          }
        ],
        "showOperandSeries": true
      }
    },
    {
      "id": "phone-request-latency",
      "name": "Phone request latency",
      "x": 12,
      "y": 6,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "line",
        "sourceId": "@METRICS_SOURCE_ID@",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.5,
            "valueExpression": "Value",
            "metricName": "harold.phone_request.latency",
            "metricType": "histogram",
            "where": "",
            "whereLanguage": "sql",
            "alias": "median"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Value",
            "metricName": "harold.phone_request.latency",
            "metricType": "histogram",
            "where": "",
            "whereLanguage": "sql",
            "alias": "p95"
          }
        ],
        "numberFormat": {
          "output": "time",
          "factor": 1
        }
      }
    },
    {
      "id": "one-turn",
      "name": "One turn, end to end",
      "x": 0,
      "y": 12,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "search",
        "sourceId": "@TRACES_SOURCE_ID@",
        "whereLanguage": "sql",
        "where": "ServiceName = 'harold' AND SpanName = 'harold.turn'",
        "select": "Timestamp, SpanAttributes['session.id'], SpanAttributes['pane_id'], SpanAttributes['started_by'], Duration / 1e9 AS seconds, TraceId"
      }
    },
    {
      "id": "turns-per-session",
      "name": "Turns per session",
      "x": 12,
      "y": 12,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "stacked_bar",
        "sourceId": "@METRICS_SOURCE_ID@",
        "select": [
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "harold.turns",
            "metricType": "sum",
            "where": "",
            "whereLanguage": "sql",
            "alias": "turns"
          }
        ],
        "groupBy": "Attributes['session.id']"
      }
    },
    {
      "id": "specs-by-state",
      "name": "Specs by state",
      "x": 0,
      "y": 18,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "line",
        "sourceId": "@METRICS_SOURCE_ID@",
        "select": [
          {
            "aggFn": "sum",
            "valueExpression": "Value",
            "metricName": "pod.specs",
            "metricType": "gauge",
            "where": "",
            "whereLanguage": "sql",
            "alias": "specs"
          }
        ],
        "groupBy": "Attributes['pod.product'], Attributes['state']"
      }
    },
    {
      "id": "spec-size",
      "name": "Spec size",
      "x": 12,
      "y": 18,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "table",
        "sourceId": "@METRICS_SOURCE_ID@",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "Value",
            "metricName": "pod.spec.words",
            "metricType": "gauge",
            "where": "",
            "whereLanguage": "sql",
            "alias": "words"
          }
        ],
        "groupBy": "Attributes['pod.product'], Attributes['spec.id'], Attributes['state']"
      }
    },
    {
      "id": "start-to-completion",
      "name": "Start to completion",
      "x": 0,
      "y": 24,
      "w": 12,
      "h": 6,
      "config": {
        "displayType": "table",
        "sourceId": "@METRICS_SOURCE_ID@",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.5,
            "valueExpression": "Value",
            "metricName": "pod.spec.lead_time",
            "metricType": "histogram",
            "where": "",
            "whereLanguage": "sql",
            "alias": "p50"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "valueExpression": "Value",
            "metricName": "pod.spec.lead_time",
            "metricType": "histogram",
            "where": "",
            "whereLanguage": "sql",
            "alias": "p95"
          }
        ],
        "groupBy": "Attributes['pod.product'], Attributes['phase']",
        "numberFormat": {
          "output": "time",
          "factor": 1
        }
      }
    }
  ]
}
