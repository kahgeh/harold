{
  "name": "phone-request-slow",
  "note": "phone-request-slow",
  "message": "The 95th percentile phone request latency was above 60 seconds in the last hour.",
  "source": "inline",
  "chartConfig": {
    "name": "phone-request-slow",
    "displayType": "line",
    "sourceId": "@TRACES_SOURCE_ID@",
    "select": [
      {
        "aggFn": "quantile",
        "level": 0.95,
        "valueExpression": "Duration / 1e9",
        "where": "ServiceName = 'harold' AND SpanName = 'harold.phone_request' AND SpanAttributes['pane_id'] != ''",
        "whereLanguage": "sql"
      }
    ]
  },
  "threshold": 60,
  "thresholdType": "above_exclusive",
  "interval": "1h",
  "channel": {
    "type": "webhook",
    "webhookId": "@WEBHOOK_ID@"
  },
  "tags": [
    "harold"
  ]
}
